<section class="demo-section">
  <h2 class="section-subheading">Journey</h2>
  <p class="section-desc">
    This one is from chapter 1. Press run, then drag the sliders to feel the
    difference between starting fast and finishing fast.
  </p>

  <!-- Simulator Card -->
  <div class="simulator-card">
    <!-- Text Stream Box -->
    <div class="stream-display" id="streamDisplay">
      <span class="placeholder-text" id="streamText"
        >Press run to stream a response.</span
      >
    </div>

    <!-- Metrics Row -->
    <div class="metrics-grid">
      <div class="metric-item">
        <span class="metric-label">TTFT</span>
        <div class="metric-value">
          <span class="value-number" id="valTtft">400</span>
          <span class="value-unit">ms</span>
        </div>
        <span class="metric-desc">Compute bound, scales with prompt length</span
        >
      </div>

      <div class="metric-item">
        <span class="metric-label">TPS</span>
        <div class="metric-value">
          <span class="value-number" id="valTps">30</span>
          <span class="value-unit">/s</span>
        </div>
        <span class="metric-desc"
          >Bandwidth bound: the same full model read every token</span
        >
      </div>

      <div class="metric-item">
        <span class="metric-label">Total</span>
        <div class="metric-value">
          <span class="value-number" id="valTotal">1.4</span>
          <span class="value-unit">s</span>
        </div>
        <span class="metric-desc">31 words end to end</span>
      </div>
    </div>

    <!-- Controls Section -->
    <div class="controls-panel">
      <div class="controls-header">
        <svg
          class="control-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="6" cy="6" r="3"></circle>
          <circle cx="6" cy="18" r="3"></circle>
          <line x1="20" y1="4" x2="8.5" y2="4" stroke-linecap="round"></line>
          <line x1="20" y1="12" x2="4" y2="12" stroke-linecap="round"></line>
          <line x1="20" y1="20" x2="8.5" y2="20" stroke-linecap="round"></line>
        </svg>
        <span>Adjust</span>
      </div>

      <div class="sliders-row">
        <div class="slider-control">
          <div class="slider-box">
            <span class="slider-name">Time to first token</span>
            <div class="slider-value-badge" id="ttftBadge">400ms</div>
          </div>
          <input
            type="range"
            id="sliderTtft"
            min="50"
            max="1500"
            step="50"
            value="400"
            class="range-slider"
          />
        </div>

        <div class="slider-control">
          <div class="slider-box">
            <span class="slider-name">Tokens per second</span>
            <div class="slider-value-badge" id="tpsBadge">30/s</div>
          </div>
          <input
            type="range"
            id="sliderTps"
            min="5"
            max="100"
            step="5"
            value="30"
            class="range-slider"
          />
          <span class="slider-subtext" id="tpsSubtext">33ms between tokens</span
          >
        </div>
      </div>

      <div class="controls-action">
        <button id="runBtn" class="btn-run">
          <svg viewBox="0 0 24 24" fill="currentColor" class="run-icon">
            <polygon points="5,3 19,12 5,21"></polygon>
          </svg>
          <span>Run</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Figure Caption -->
  <div class="figure-caption">
    <p>
      <strong>Figure 1.4. Time to first token versus tokens per second.</strong> Two
      numbers, two phases, two bottlenecks. A response that starts instantly and trickles
      can feel faster than one that pauses and then dumps, even when the second finishes
      first.
    </p>
    <span class="figure-subcaption">Illustrative numbers</span>
  </div>
</section>

