---
import "drawably/style.css";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  variant?: "solid" | "outline";
  size?: "small" | "default" | "large";
  fullWidth?: boolean;
  roughness?: number;
}

const {
  variant = "solid",
  size = "default",
  fullWidth = false,
  type = "button",
  class: className,
  roughness = 0.8,
  ...attributes
} = Astro.props;
---

<button
  {...attributes}
  type={type}
  class:list={[
    "drawably-button",
    `sketch-button-${variant}`,
    `sketch-button-${size}`,
    { "full-width": fullWidth },
    className,
  ]}
  data-sketch-button={variant}
  data-roughness={roughness}
>
  <slot />
</button>

<script>
  import { drawablyButton } from "drawably";
  import { initializeSketches } from "./initializeSketches";

  initializeSketches<HTMLButtonElement>("[data-sketch-button]", (el) =>
    drawablyButton(el, {
      roughness: el.dataset.roughness ? parseFloat(el.dataset.roughness) : 0.8,
      boil: 0.2,
      variant: el.dataset.sketchButton === "outline" ? "outline" : "solid",
    })
  );
</script>

<style>
  .drawably-button {
    font: inherit;
    cursor: pointer;
  }
  .sketch-button-small {
    padding: 0.45rem 0.75rem;
    font-size: 0.875em;
  }
  .sketch-button-default {
    padding: 0.7rem 1rem;
  }
  .sketch-button-large {
    padding: 0.95rem 1.5rem;
    font-size: 1.125em;
  }
  .full-width {
    width: 100%;
  }
  .sketch-button-solid {
    color: var(--color-white);
    --drawably-stroke: var(--color-black);
    --drawably-fill: var(--color-green);
  }
  .sketch-button-outline {
    color: var(--color-black);
    --drawably-stroke: var(--color-blue);
    --drawably-fill: var(--color-white);
  }
</style>
