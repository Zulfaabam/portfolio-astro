---
import ExternalLink from "./ui/ExternalLink.astro";

interface Props {
  id: string;
  title?: string;
  triggerLabel?: string;
  itemLabel?: string;
  pages?: Array<{
    kicker?: string;
    title: string;
    body: string;
    links?: Array<{ href?: string | null; label: string }>;
    images?: Array<{ src: string; alt: string; caption?: string }>;
  }>;
}

const {
  id,
  title = "A little note",
  triggerLabel,
  itemLabel = "Note",
  pages = [{ title, body: "" }],
} = Astro.props;

const dialogId = id;
---

{
  triggerLabel && (
    <button
      class="custom-note-trigger"
      type="button"
      data-custom-note-open={dialogId}
    >
      {triggerLabel}
    </button>
  )
}

<dialog
  class="custom-note-dialog"
  id={dialogId}
  aria-labelledby={`${dialogId}-title-0`}
  data-item-label={itemLabel}
>
  <div class="custom-note-backdrop" data-custom-note-close></div>
  <div class="custom-note-stack" role="document" aria-live="polite">
    {
      pages.map((page, pageIndex) => (
        <article
          class:list={[
            "custom-note-page",
            pageIndex === 0 && "custom-note-page-front",
          ]}
          data-custom-note-page
          data-page-index={pageIndex}
          aria-hidden={pageIndex === 0 ? undefined : "true"}
        >
          <svg
            class="custom-note-shape"
            viewBox="0 0 440 560"
            preserveAspectRatio="none"
            aria-hidden="true"
          />
          <div class="custom-note-content">
            <button
              class="custom-note-close"
              type="button"
              aria-label="Close note"
              data-custom-note-close
            >
              ×
            </button>
            <div
              class:list={[
                "custom-note-body",
                { "scrapbook-layout": page.images?.length },
              ]}
            >
              <header class="custom-note-heading">
                <p class="custom-note-kicker">
                  {page.kicker ?? "A little note"}
                </p>
                <h2 id={`${dialogId}-title-${pageIndex}`}>{page.title}</h2>
              </header>
              <div class="custom-note-details">
                <div class="scrapbook-note">
                  {page.body ? <p>{page.body}</p> : <slot />}
                </div>
                {page.links?.length && (
                  <div class="scrapbook-links">
                    <span class="scrapbook-label">Explore the project</span>
                    {page.links?.map((link) =>
                      link.href ? (
                        <ExternalLink href={link.href} underline>
                          {link.label}
                        </ExternalLink>
                      ) : (
                        <p>{link.label}</p>
                      )
                    )}
                  </div>
                )}
              </div>
              {page.images?.length && (
                <div class="scrapbook-photos">
                  {page.images.slice(0, 1).map((image) => (
                    <figure class="scrapbook-photo">
                      <img
                        src={image.src}
                        alt={image.alt}
                        loading="lazy"
                        decoding="async"
                      />
                      {image.caption && (
                        <figcaption>{image.caption}</figcaption>
                      )}
                    </figure>
                  ))}
                </div>
              )}
            </div>
            <div class="custom-note-footer">
              <p class="custom-note-status" data-custom-note-status>
                {itemLabel} {pageIndex + 1} of {pages.length}
              </p>
              {pages.length > 1 && (
                <div>
                  <button
                    class="custom-note-nav custom-note-nav-previous"
                    type="button"
                    aria-label={`Previous ${itemLabel.toLowerCase()}`}
                    title={`Previous ${itemLabel.toLowerCase()}`}
                    data-custom-note-previous
                  >
                    <svg
                      class="custom-note-nav-icon"
                      viewBox="0 0 32 24"
                      aria-hidden="true"
                    />
                  </button>
                  <button
                    class="custom-note-nav custom-note-nav-next"
                    type="button"
                    aria-label={`Next ${itemLabel.toLowerCase()}`}
                    title={`Next ${itemLabel.toLowerCase()}`}
                    data-custom-note-next
                  >
                    <svg
                      class="custom-note-nav-icon"
                      viewBox="0 0 32 24"
                      aria-hidden="true"
                    />
                  </button>
                </div>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</dialog>

<script>
  import { roughArrow, roughRoundedRect, scribbleFill } from "drawably";
  import { drawablyButton } from "drawably";
  import { randomSeed } from "drawably";

  const initializeNotes = () => {
    document
      .querySelectorAll<HTMLDialogElement>(".custom-note-dialog")
      .forEach((dialog) => {
        if (dialog.dataset.ready) return;
        dialog.dataset.ready = "true";

        const stack = dialog.querySelector<HTMLElement>(".custom-note-stack");
        const openers = document.querySelectorAll<HTMLButtonElement>(
          `[data-custom-note-open="${dialog.id}"], [data-dialog-trigger="${dialog.id}"]`
        );
        const pages = Array.from(
          dialog.querySelectorAll<HTMLElement>("[data-custom-note-page]")
        );
        const closeButtons = dialog.querySelectorAll<HTMLElement>(
          "[data-custom-note-close]"
        );
        const previousButtons = dialog.querySelectorAll<HTMLButtonElement>(
          "[data-custom-note-previous]"
        );
        const nextButtons = dialog.querySelectorAll<HTMLButtonElement>(
          "[data-custom-note-next]"
        );
        const statuses = dialog.querySelectorAll<HTMLElement>(
          "[data-custom-note-status]"
        );
        let closeTimer: number | undefined;
        let lastFocused: HTMLElement | null = null;
        let pageIndex = 0;
        let swipeStartX: number | null = null;
        let swipeStartY: number | null = null;

        if (!stack) return;

        const attachNavigationIcon = (
          button: HTMLButtonElement,
          direction: "previous" | "next"
        ) => {
          const svg = button.querySelector<SVGSVGElement>(
            ".custom-note-nav-icon"
          );
          if (!svg) return;

          const seed = randomSeed();
          const path = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "path"
          );
          const startX = direction === "previous" ? 25 : 7;
          const endX = direction === "previous" ? 7 : 25;
          path.setAttribute(
            "d",
            roughArrow(startX, 12, endX, 12, {
              seed,
              roughness: 0.85,
              boil: 0.2,
            })
          );
          path.setAttribute("fill", "none");
          path.setAttribute("stroke", "currentColor");
          path.setAttribute("stroke-width", "2");
          path.setAttribute("stroke-linecap", "round");
          path.setAttribute("stroke-linejoin", "round");
          svg.append(path);
        };

        previousButtons.forEach((button) =>
          attachNavigationIcon(button, "previous")
        );
        nextButtons.forEach((button) => attachNavigationIcon(button, "next"));
        [...previousButtons, ...nextButtons].forEach((button) => {
          drawablyButton(button, {
            variant: "solid",
            roughness: 0.85,
            boil: 0.2,
          });
        });

        pages.forEach((page, index) => {
          const svg = page.querySelector<SVGSVGElement>(".custom-note-shape");
          if (!svg) return;

          const seed = randomSeed();
          const options = { seed, roughness: 0.85, boil: 0.2 };
          const outline = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "path"
          );
          const shapeX = 5;
          const shapeWidth = 430;
          outline.setAttribute(
            "d",
            roughRoundedRect(shapeX, 20, shapeWidth, 520, 18, options)
          );
          outline.setAttribute("fill", "#f6efdc");
          outline.setAttribute("stroke", "#2724d1");
          outline.setAttribute("stroke-width", "2");
          outline.setAttribute("stroke-linejoin", "round");

          const texture = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "path"
          );
          texture.setAttribute(
            "d",
            scribbleFill(shapeX + 12, 32, shapeWidth - 24, 496, options)
          );
          texture.setAttribute("fill", "none");
          texture.setAttribute("stroke", "#2724d1");
          texture.setAttribute("stroke-width", "0.7");
          texture.setAttribute("stroke-opacity", "0.06");

          svg.append(outline, texture);
          page.dataset.pageIndex = String(index);
        });

        const updateStack = () => {
          dialog.setAttribute(
            "aria-labelledby",
            `${dialog.id}-title-${pageIndex}`
          );
          pages.forEach((page, index) => {
            const depth = (index - pageIndex + pages.length) % pages.length;
            page.dataset.depth = String(depth);
            page.setAttribute("aria-hidden", depth === 0 ? "false" : "true");
            page.tabIndex = depth === 0 ? 0 : -1;
            page.inert = depth !== 0;
          });
          statuses.forEach((status) => {
            status.textContent = `${dialog.dataset.itemLabel ?? "Note"} ${pageIndex + 1} of ${pages.length}`;
          });
          nextButtons.forEach((button) => {
            button.disabled = pages.length < 2;
          });
        };

        const changePage = (direction: -1 | 1) => {
          if (pages.length < 2) return;

          pageIndex = (pageIndex + direction + pages.length) % pages.length;
          updateStack();
          window.requestAnimationFrame(() => {
            dialog
              .querySelector<HTMLElement>(
                `[data-depth="0"] [data-custom-note-${direction === 1 ? "next" : "previous"}]`
              )
              ?.focus();
          });
        };

        const close = () => {
          if (!dialog.open || dialog.dataset.state === "closing") return;
          dialog.dataset.state = "closing";
          closeTimer = window.setTimeout(() => {
            dialog.close();
            document.body.classList.remove("custom-note-scroll-locked");
            delete dialog.dataset.state;
            lastFocused?.focus();
          }, 760);
        };

        const open = (opener: HTMLButtonElement) => {
          if (closeTimer) window.clearTimeout(closeTimer);
          const requestedPage = Number(opener.dataset.dialogPage ?? 0);
          pageIndex =
            Number.isInteger(requestedPage) &&
            requestedPage >= 0 &&
            requestedPage < pages.length
              ? requestedPage
              : 0;
          updateStack();
          lastFocused = document.activeElement as HTMLElement;
          dialog.dataset.state = "opening";
          document.body.classList.add("custom-note-scroll-locked");
          dialog.showModal();
          requestAnimationFrame(() => (dialog.dataset.state = "open"));
          dialog
            .querySelector<HTMLElement>('[data-depth="0"] .custom-note-close')
            ?.focus();
        };
        openers.forEach((opener) =>
          opener.addEventListener("click", () => open(opener))
        );
        closeButtons.forEach((button) =>
          button.addEventListener("click", close)
        );
        previousButtons.forEach((button) =>
          button.addEventListener("click", () => changePage(-1))
        );
        nextButtons.forEach((button) =>
          button.addEventListener("click", () => changePage(1))
        );
        stack.addEventListener(
          "touchstart",
          (event) => {
            if (!dialog.open || event.touches.length !== 1) return;
            swipeStartX = event.touches[0].clientX;
            swipeStartY = event.touches[0].clientY;
          },
          { passive: true }
        );
        const handleTouchEnd = (event: TouchEvent) => {
          if (swipeStartX === null || swipeStartY === null) return;

          const touch = event.changedTouches[0];
          const deltaX = touch.clientX - swipeStartX;
          const deltaY = touch.clientY - swipeStartY;
          swipeStartX = null;
          swipeStartY = null;

          if (deltaX > -50 || Math.abs(deltaX) <= Math.abs(deltaY) * 1.2)
            return;
          event.preventDefault();
          changePage(1);
        };
        stack.addEventListener("touchend", handleTouchEnd, { passive: false });
        stack.addEventListener("touchcancel", () => {
          swipeStartX = null;
          swipeStartY = null;
        });
        dialog.addEventListener("cancel", (event) => {
          event.preventDefault();
          close();
        });
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) close();
        });
      });
  };

  initializeNotes();
  document.addEventListener("astro:page-load", initializeNotes);
</script>

<style>
  .custom-note-trigger {
    width: 100%;
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-blue);
    background: var(--color-white);
    color: var(--color-black);
    font: inherit;
    cursor: pointer;
  }

  .custom-note-trigger,
  .custom-note-close,
  .custom-note-nav {
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .custom-note-trigger:active,
  .custom-note-close:active,
  .custom-note-nav:active:not(:disabled) {
    transform: scale(0.97);
  }

  :global(body.custom-note-scroll-locked) {
    overflow: hidden;
    overscroll-behavior: none;
  }

  .custom-note-dialog {
    width: min(860px, calc(100vw - 3rem));
    max-width: none;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .custom-note-dialog::backdrop {
    background: rgb(9 10 12 / 72%);
  }

  .custom-note-backdrop {
    position: fixed;
    inset: 0;
  }

  .custom-note-stack {
    position: relative;
    z-index: 1;
    height: min(660px, calc(100dvh - 5rem));
    perspective: 1400px;
    filter: drop-shadow(0 22px 28px rgb(0 0 0 / 28%));
    touch-action: pan-y;
  }

  .custom-note-page {
    opacity: 0;
    position: absolute;
    inset: 0;
    transform: translate3d(0, 0, 0) rotate(0deg);
    transform-style: preserve-3d;
    backface-visibility: hidden;
    transition:
      transform 560ms cubic-bezier(0.22, 0.75, 0.25, 1),
      opacity 220ms ease;
  }

  .custom-note-page[data-depth="0"] {
    z-index: 4;
    opacity: 1;
  }

  .custom-note-page[data-depth="1"] {
    z-index: 3;
    transform: translate3d(0.65rem, 0.55rem, -20px) rotate(1.2deg);
    opacity: 0.94;
  }

  .custom-note-page[data-depth="2"] {
    z-index: 2;
    transform: translate3d(1.15rem, 1rem, -40px) rotate(-1.3deg);
    opacity: 0.88;
  }

  .custom-note-page[data-depth="3"] {
    z-index: 1;
    transform: translate3d(1.6rem, 1.35rem, -60px) rotate(1.8deg);
    opacity: 0.8;
  }

  .custom-note-dialog[data-state="opening"] .custom-note-page {
    transform: translate3d(0, 115vh, 120px) rotate(11deg);
    opacity: 0;
  }

  .custom-note-dialog[data-state="opening"] .custom-note-page[data-depth="1"] {
    transition-delay: 60ms;
  }

  .custom-note-dialog[data-state="opening"] .custom-note-page[data-depth="2"] {
    transition-delay: 120ms;
  }

  .custom-note-dialog[data-state="opening"] .custom-note-page[data-depth="3"] {
    transition-delay: 180ms;
  }

  .custom-note-dialog[data-state="closing"] .custom-note-page {
    transform: translate3d(0, 115vh, 120px) rotate(11deg);
    opacity: 0;
    transition:
      transform 560ms cubic-bezier(0.42, 0, 1, 1),
      opacity 420ms ease;
  }

  .custom-note-dialog[data-state="closing"] .custom-note-page[data-depth="0"] {
    z-index: 5;
  }

  .custom-note-dialog[data-state="closing"] .custom-note-page[data-depth="1"] {
    transition-delay: 60ms;
  }

  .custom-note-dialog[data-state="closing"] .custom-note-page[data-depth="2"] {
    transition-delay: 120ms;
  }

  .custom-note-dialog[data-state="closing"] .custom-note-page[data-depth="3"] {
    transition-delay: 180ms;
  }

  .custom-note-shape {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .custom-note-content {
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    min-width: 0;
    max-width: 100%;
    height: 100%;
    padding: 4rem 3.5rem 3rem;
    overflow: hidden;
    opacity: 0;
    transform: translateY(0.75rem);
  }

  .custom-note-page[data-page-index="0"] .custom-note-content {
    transition:
      opacity 220ms ease 260ms,
      transform 220ms ease 260ms;
  }

  .custom-note-dialog[data-state="open"]
    .custom-note-page[data-page-index="0"]
    .custom-note-content,
  .custom-note-page[data-depth="0"]:not([data-page-index="0"])
    .custom-note-content {
    opacity: 1;
    transform: translateY(0);
  }

  .custom-note-page:not([data-depth="0"]) .custom-note-content {
    pointer-events: none;
    opacity: 0;
  }

  .custom-note-page:not([data-depth="0"]) .custom-note-nav {
    pointer-events: none;
    opacity: 0;
  }

  .custom-note-page[data-depth="0"] .custom-note-content {
    transition: none;
  }

  .custom-note-dialog[data-state="opening"]
    .custom-note-page[data-page-index="0"]
    .custom-note-content {
    transition:
      opacity 220ms ease 260ms,
      transform 220ms ease 260ms;
  }

  .custom-note-close {
    z-index: 2;
    width: 44px;
    height: 44px;
    position: absolute;
    top: clamp(1.5rem, 4vw, 2.5rem);
    right: clamp(1.5rem, 4vw, 2.5rem);
    border: 0;
    background: transparent;
    color: var(--color-black);
    font: inherit;
    font-size: 1.75rem;
    cursor: pointer;
  }

  .custom-note-nav {
    z-index: 5;
    display: grid;
    width: 44px;
    height: 44px;
    padding: 0;
    place-items: center;
    color: var(--color-black);
    font: inherit;
    cursor: pointer;
    --drawably-stroke: var(--color-blue);
    --drawably-fill: var(--color-paper);
  }

  .custom-note-footer {
    flex-shrink: 0;
    padding-block-start: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .custom-note-footer > div {
    display: flex;
    flex-shrink: 0;
    gap: 0.75rem;
  }

  .custom-note-nav-icon {
    width: 1.5rem;
    height: 1.125rem;
    overflow: visible;
  }

  .custom-note-nav:disabled {
    cursor: wait;
    opacity: 0.5;
  }

  .custom-note-status {
    margin: 0.8rem 0 0;
    color: var(--color-dark-gray);
    font-size: 0.75rem;
  }

  .custom-note-kicker {
    margin: 0 0 0.75rem;
    color: var(--color-green);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .custom-note-content h2 {
    min-width: 0;
    margin: 0 0 1.5rem;
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .custom-note-body {
    --scrollbar-track: #eee5d0;
    --scrollbar-thumb: color-mix(in srgb, var(--color-paper) 80%, #eee5d0);
    min-height: 0;
    flex: 1;
    min-width: 0;
    overflow: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
    overflow-wrap: anywhere;
    word-break: break-word;
    font-size: 0.85rem;
    line-height: 1.65;
    overscroll-behavior: contain;
    padding: 1rem;
  }

  @supports selector(::-webkit-scrollbar) {
    .custom-note-body {
      scrollbar-width: auto;
      scrollbar-color: auto;
    }

    .custom-note-body::-webkit-scrollbar {
      width: 10px;
      height: 10px;
    }

    .custom-note-body::-webkit-scrollbar-track {
      background: var(--scrollbar-track);
      border-radius: 12px;
      margin-block: 0.5rem;
    }

    .custom-note-body::-webkit-scrollbar-thumb {
      background: var(--scrollbar-thumb);
      border: 2px solid var(--scrollbar-track);
      border-radius: 12px;
      min-height: 36px;
    }

    .custom-note-body::-webkit-scrollbar-thumb:hover,
    .custom-note-body::-webkit-scrollbar-thumb:active {
      background: var(--color-blue);
    }

    .custom-note-body::-webkit-scrollbar-corner {
      background: transparent;
    }
  }

  @media (forced-colors: active) {
    .custom-note-body {
      --scrollbar-track: Canvas;
      --scrollbar-thumb: ButtonText;
      scrollbar-color: auto;
    }

    .custom-note-body::-webkit-scrollbar-thumb:hover,
    .custom-note-body::-webkit-scrollbar-thumb:active {
      background: Highlight;
    }
  }

  .scrapbook-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    grid-template-areas: "heading photos" "details photos";
    column-gap: 0;
    align-content: start;
    isolation: isolate;
  }

  .custom-note-heading {
    grid-area: heading;
    padding-inline: 0.75rem;
  }
  .custom-note-details {
    grid-area: details;
    align-content: start;
    position: relative;
    isolation: isolate;
  }

  .scrapbook-layout .custom-note-details::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -0.75rem 1.25rem 1.5rem -0.25rem;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0 17px,
        rgb(103 85 58 / 12%) 17px 18px
      ),
      #d9cbb0;
    transform: rotate(-4deg);
    box-shadow: 1px 3px 6px rgb(67 49 24 / 10%);
    pointer-events: none;
  }

  .scrapbook-photos {
    grid-area: photos;
    min-width: 0;
    padding: 3.5rem 0.5rem 1rem;
    align-self: start;
    width: min(100%, 360px);
    box-sizing: border-box;
    justify-self: start;
    margin-inline-start: -2rem;
    position: relative;
    z-index: 2;
  }

  .scrapbook-photo {
    position: relative;
    margin: 0;
    padding: 0.6rem 0.6rem 0.8rem;
    background: #fffdf6;
    box-shadow:
      0 3px 6px rgb(55 44 24 / 12%),
      0 12px 20px rgb(55 44 24 / 8%);
    transform: rotate(4deg);
  }

  .scrapbook-photo::before {
    content: "";
    position: absolute;
    z-index: 1;
    width: 5rem;
    height: 1.6rem;
    inset-block-start: -0.7rem;
    inset-inline-start: 35%;
    background: repeating-linear-gradient(
      90deg,
      rgb(214 194 146 / 65%) 0 3px,
      rgb(226 209 171 / 65%) 3px 6px
    );
    transform: rotate(5deg);
    clip-path: polygon(2% 0, 98% 4%, 100% 92%, 0 100%);
  }

  .scrapbook-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 8 / 5;
    object-fit: contain;
    background: #e5eadf;
  }

  .scrapbook-photo figcaption {
    margin-block-start: 0.5rem;
    font-size: 0.75rem;
    color: #58604b;
    letter-spacing: 0.04em;
  }

  .custom-note-details {
    display: grid;
    gap: 0;
    padding: 0.25rem 0.75rem 1rem;
  }

  .scrapbook-note {
    position: relative;
    isolation: isolate;
    padding: 1.5rem 4rem 2.5rem 1.5rem;
    transform: rotate(-2deg);
    filter: drop-shadow(1px 3px 2px rgb(67 49 24 / 12%));
  }

  .scrapbook-note::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #e8d9b9;
    clip-path: polygon(
      1% 1%,
      20% 0,
      43% 1%,
      68% 0,
      99% 2%,
      100% 25%,
      99% 60%,
      97% 87%,
      91% 99%,
