---
import PaperNoteCustomDialog from "./PaperNoteCustomDialog";

interface Props {
  id: string;
  title?: string;
  triggerLabel?: string;
  itemLabel?: string;
  pages: { id: string; label: string }[];
}

const { pages, ...props } = Astro.props;
// Render each function child on the server, preserving Astro's escaping and CSS.
// Only the resulting HTML and page labels cross the island boundary.
const renderedPages = await Promise.all(
  pages.map(async (page, index) => ({
    ...page,
    html: String(await Astro.slots.render("default", [index])),
  })),
);
---

<PaperNoteCustomDialog {...props} pages={renderedPages} client:load />
