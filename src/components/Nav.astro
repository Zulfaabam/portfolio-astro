---
const isBlog =
  Astro.url.pathname === "/blog" || Astro.url.pathname.startsWith("/blog/");
---

<nav class="top-nav" aria-label="Main navigation">
  <div class="nav-container">
    <a href="/" class="brand">
      <span class="brand-text">Abams-Folio</span>
    </a>

    <a href="/blog" aria-current={isBlog ? "page" : undefined} class="nav-link">
      <span>Blog</span>
    </a>
  </div>
</nav>

<style>
  /* Top Navigation */
  .top-nav {
    width: 100%;
    border-bottom: 1px solid #181a1f;
    background-color: rgba(9, 10, 12, 0.85);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav-container {
    max-width: var(--site-width);
    min-height: var(--nav-height);
    margin: 0 auto;
    padding: 0.5rem var(--site-gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #f3f4f6;
    letter-spacing: -0.01em;
  }

  .brand,
  .nav-link {
    min-height: 44px;
  }

  .brand:focus-visible,
  .nav-link:focus-visible {
    outline: 2px solid #f3f4f6;
    outline-offset: 4px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    color: #9ca3af;
    transition: color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: #f3f4f6;
  }
</style>
