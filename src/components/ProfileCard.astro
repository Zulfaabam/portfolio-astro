---
import { Image } from "astro:assets";
import profileImage from "../assets/abam-in-fmlx.jpg";
import TiltCard from "./TiltCard.astro";
---

<div class="profile-card drawably-card" data-drawably-card>
  <TiltCard fill>
    <Image
      src={profileImage}
      alt="Zulfa Fatah Akbar Ahmad"
      class="profile-image"
    />
    <div class="profile-caption">
      <span class="profile-mark" aria-hidden="true">✦</span>
      <div>
        <h2>Zulfa Fatah<br />Akbar Ahmad</h2>
        <p>Software Engineer</p>
      </div>
    </div>
  </TiltCard>
</div>

<style>
  .profile-card {
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    min-width: 0;
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.35;
    padding: 1rem;
    color: var(--color-white);
    --drawably-stroke: var(--color-black);
    --drawably-fill: var(--color-blue);
  }
  .profile-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .profile-caption {
    position: absolute;
    inset: 0;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: rgb(0 0 0 / 30%);
    pointer-events: none;
  }
  .profile-mark {
    font-size: 2rem;
    line-height: 1;
  }
  .profile-caption h2 {
    margin: 0;
    font-size: 1.55rem;
    line-height: 1.05;
  }
  .profile-caption p {
    margin: 0.75rem 0 0;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
