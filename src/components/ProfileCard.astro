---
import { Image } from "astro:assets";
import backsideImage from "../assets/abam-in-fmlx.jpg";
---

<!-- Preload the backside image -->
<link rel="preload" as="image" href={backsideImage.src} />

<div class="flip-container drawably-card" data-drawably-card>
  <div class="flip-card">
    <!-- Front of card -->
    <div class="flip-card-front">
      <span class="profile-mark">✦</span>
      <div>
        <h2>Zulfa Fatah<br />Akbar Ahmad</h2>
        <p>Software Engineer</p>
      </div>
    </div>

    <!-- Back of card -->
    <div class="flip-card-back">
      <Image src={backsideImage} alt="Abam in FMLX" priority loading="eager" />
    </div>
  </div>
</div>

<script>
  import { drawablyCard } from "drawably";

  document.querySelectorAll<HTMLElement>("[data-drawably-card]").forEach((el) =>
    drawablyCard(el, {
      roughness: 0.8,
      boil: 0.2,
      fill: "#2724d1",
    }),
  );
</script>

<style>
  /* Flip Container */
  .flip-container {
    width: 100%;
    aspect-ratio: 1 / 1.35;
    perspective: 1000px;

    padding: 1rem;
    color: var(--color-white);
    --drawably-stroke: var(--color-black);
    --drawably-fill: var(--color-blue);
  }

  .flip-card {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.6s;
    transform-style: preserve-3d;
  }

  .flip-container:hover .flip-card {
    transform: rotateY(180deg);
  }

  .flip-card-front {
    border-radius: 8px;
    min-height: 100%;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: rgba(0, 0, 0, 0.3) url("/src/assets/abam.jpg") center / cover
      no-repeat;
    background-blend-mode: overlay;
  }

  .profile-mark {
    font-size: 2rem;
    line-height: 1;
  }
  .flip-card-front h2 {
    margin: 0;
    font-size: 1.55rem;
    line-height: 1.05;
  }
  .flip-card-front p {
    margin: 0.75rem 0 0;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .flip-card-front,
  .flip-card-back {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .flip-card-back {
    transform: rotateY(180deg);
  }

  /* Back of card - Image */
  .flip-card-back {
    border-radius: 8px;
    overflow: hidden;
    box-shadow:
      0 16px 36px -10px rgba(0, 189, 126, 0.25),
      0 0 0 1px rgba(255, 255, 255, 0.1) inset;
  }

  .flip-card-back img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
