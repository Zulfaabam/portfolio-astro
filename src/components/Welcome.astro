---
import ArrowUpRightSvg from "./ArrowUpRightSvg.astro";
import ChapterCard from "./ChapterCard.astro";
import Nav from "./Nav.astro";
import ProfileCard from "./ProfileCard.astro";
import ProjectTooltipCard from "../components/ProjectTooltipCard.astro";
import { getEntry } from "astro:content";

const homeContent = await getEntry("home", "home");

const miniJourneys = homeContent?.data?.miniJourneys?.sort(
  (a, b) => b.id - a.id,
);
---

<div class="page-wrapper">
  <Nav />

  <div class="main-layout">
    <!-- Left Column / Sidebar -->
    <aside class="sidebar">
      <div class="sticky-sidebar">
        <ProfileCard />

        <!-- Action Buttons -->
        <div class="sidebar-actions">
          <a href="#read" class="btn btn-primary">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2z"
              ></path>
              <path
                d="M3 7l9 6 9-6"
                stroke="currentColor"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <span>View My Work</span>
          </a>

          <a href="#glossary" class="btn btn-secondary">
            <svg
              class="btn-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <polyline
                points="7 10 12 15 17 10"
                stroke-linecap="round"
                stroke-linejoin="round"></polyline>
              <line
                x1="12"
                y1="15"
                x2="12"
                y2="3"
                stroke-linecap="round"
                stroke-linejoin="round"></line>
            </svg>
            <span>Download Resume</span>
          </a>
        </div>
      </div>
    </aside>

    <!-- Right Column / Content -->
    <main class="content-area">
      <!-- Intro -->
      <section class="prose-section">
        <h1 class="section-heading">Hi, I'm Abam!</h1>
        <p>
          {homeContent?.data?.intro}
        </p>
      </section>

      <section class="chapters-section">
        <!-- Journey -->
        <div class="chapter-group">
          <a href="#ch-0" class="chapter-header">
            <h3>Journey</h3>
            <ArrowUpRightSvg className="header-arrow" />
          </a>

          <ChapterCard>
            {
              miniJourneys?.map((journey, index) => (
                <div
                  class="lesson-row journey-row"
                  tabindex="0"
                  aria-describedby={`journey-tooltip-${journey.id}`}
                >
                  <span class="lesson-icon">
                    <ArrowUpRightSvg />
                  </span>
                  <span class="lesson-num">{index + 1}</span>
                  <span class="lesson-title">{journey.job}</span>
                  <span
                    class="hint-content"
                    id={`journey-tooltip-${journey.id}`}
                    role="tooltip"
                  >
                    {journey.place} · {journey.year}
                  </span>
                </div>
              ))
            }
          </ChapterCard>
        </div>

        <!-- Chapter 1 -->
        <div class="chapter-group">
          <a href="#ch-1" class="chapter-header">
            <h3>Projects</h3>
            <ArrowUpRightSvg class="header-arrow" />
          </a>

          <ChapterCard>
            {
              homeContent?.data?.featuredProjects?.map((p, index) => (
                <div
                  class="lesson-row project-row"
                  tabindex="0"
                  aria-describedby={`project-tooltip-${p.id}`}
                >
                  <span class="lesson-icon">
                    <ArrowUpRightSvg />
                  </span>
                  <span class="lesson-num">{index + 1}</span>
                  <span class="lesson-title">{p.title}</span>
                  <div
                    class="project-tooltip"
                    id={`project-tooltip-${p.id}`}
                    role="tooltip"
                  >
                    <svg
                      class="branch-path-svg"
                      viewBox="0 0 180 70"
                      aria-hidden="true"
                    >
                      <path
                        class="branch-line"
                        d="M145,0 C145,34 25,28 25,70"
                      />
                      <circle class="branch-dot" cx="25" cy="70" r="3" />
                    </svg>
                    <div class="project-tooltip-cards">
                      <ProjectTooltipCard
                        sourceAvailable={Boolean(p.repository)}
                        demoAvailable={Boolean(p.demo)}
                      />
                    </div>
                  </div>
                </div>
              ))
            }
          </ChapterCard>
        </div>
      </section>
    </main>
  </div>
</div>

<script>
  // Interactive Simulator Script
  const sliderTtft = document.getElementById(
    "sliderTtft",
  ) as HTMLInputElement | null;
  const sliderTps = document.getElementById(
    "sliderTps",
  ) as HTMLInputElement | null;
  const ttftBadge = document.getElementById("ttftBadge");
  const tpsBadge = document.getElementById("tpsBadge");
  const valTtft = document.getElementById("valTtft");
  const valTps = document.getElementById("valTps");
  const valTotal = document.getElementById("valTotal");
  const tpsSubtext = document.getElementById("tpsSubtext");
  const runBtn = document.getElementById("runBtn");
  const streamText = document.getElementById("streamText");

  const sampleWords = (
    "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor " +
    "incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam quis nostrud."
  ).split(" ");

  let isStreaming = false;
  let streamTimeout: any = null;

  function updateMetrics() {
    if (!sliderTtft || !sliderTps) return;
    const ttft = parseInt(sliderTtft.value, 10);
    const tps = parseInt(sliderTps.value, 10);
    const msPerToken = Math.round(1000 / tps);
    const tokenCount = 31;
    const totalSec = ((ttft + (tokenCount * 1000) / tps) / 1000).toFixed(1);

    if (ttftBadge) ttftBadge.textContent = `${ttft}ms`;
    if (tpsBadge) tpsBadge.textContent = `${tps}/s`;
    if (valTtft) valTtft.textContent = `${ttft}`;
    if (valTps) valTps.textContent = `${tps}`;
    if (valTotal) valTotal.textContent = `${totalSec}`;
    if (tpsSubtext) tpsSubtext.textContent = `${msPerToken}ms between tokens`;
  }

  sliderTtft?.addEventListener("input", updateMetrics);
  sliderTps?.addEventListener("input", updateMetrics);

  runBtn?.addEventListener("click", () => {
    if (!sliderTtft || !sliderTps || !streamText) return;
    if (isStreaming) {
      clearTimeout(streamTimeout);
      isStreaming = false;
    }

    const ttft = parseInt(sliderTtft.value, 10);
    const tps = parseInt(sliderTps.value, 10);
    const tokenDelay = Math.max(10, Math.round(1000 / tps));

    streamText.textContent = "Waiting for first token...";
    streamText.classList.remove("placeholder-text");
    isStreaming = true;

    streamTimeout = setTimeout(() => {
      let index = 0;
      streamText.textContent = "";

      function nextToken() {
        if (!isStreaming || !streamText) return;
        if (index < sampleWords.length) {
          streamText.textContent +=
            (index === 0 ? "" : " ") + sampleWords[index];
          index++;
          streamTimeout = setTimeout(nextToken, tokenDelay);
        } else {
          isStreaming = false;
        }
      }

      nextToken();
    }, ttft);
  });
</script>

<style>
  /* Layout & Root Variables */
  .page-wrapper {
    min-height: 100vh;
    background-color: #090a0c;
    color: #e5e7eb;
    display: flex;
    flex-direction: column;
  }

  /* Main Container Layout */
  .main-layout {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
    display: grid;
    grid-template-columns: 290px 1fr;
    gap: 4rem;
    width: 100%;
  }

  /* Sidebar */
  .sidebar {
    width: 100%;
  }

  .sticky-sidebar {
    position: sticky;
    top: 5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Sidebar Action Buttons */
  .sidebar-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.65rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }

  .btn-icon {
    width: 15px;
    height: 15px;
  }

  .btn-primary {
    background-color: #ffffff;
    color: #090a0c;
    font-weight: 600;
  }

  .btn-primary:hover {
    background-color: #e5e7eb;
  }

  .btn-secondary {
    background-color: #121418;
    color: #d1d5db;
    border-color: #20242b;
  }

  .btn-secondary:hover {
    background-color: #181b22;
    border-color: #2d323d;
    color: #ffffff;
  }

  .btn-external {
    justify-content: space-between;
  }

  .btn-content {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .external-arrow {
    width: 14px;
    height: 14px;
    color: #6b7280;
  }

  /* Content Area */
  .content-area {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* Prose Section */
  .prose-section {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .section-heading {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: #f9fafb;
    margin: 0;
  }

  .prose-section p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: #9ca3af;
    white-space: pre-line;
  }

  .prose-section em {
    color: #d1d5db;
    font-style: italic;
  }

  /* Chapters List */
  .chapters-section {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .chapter-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .chapter-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #f9fafb;
    transition: color 0.15s ease;
  }

  .chapter-header h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .header-arrow {
    width: 14px;
    height: 14px;
    color: #6b7280;
    transition:
      transform 0.15s ease,
      color 0.15s ease;
  }

  .chapter-header:hover .header-arrow {
    color: #00bd7e;
    transform: translate(2px, -2px);
  }

  .lesson-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #181a20;
    color: #d1d5db;
    font-size: 0.875rem;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .journey-row {
    position: relative;
    cursor: default;
  }

  .project-row {
    position: relative;
    cursor: default;
  }

  .lesson-row:last-child {
    border-bottom: none;
  }

  .lesson-row:hover {
    background-color: #16181f;
    color: #ffffff;
  }

  .lesson-icon {
    width: 18px;
    height: 18px;
    border: 1px solid #282d38;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6b7280;
    flex-shrink: 0;
  }

  .lesson-icon svg {
    width: 10px;
    height: 10px;
  }

  .lesson-row:hover .lesson-icon {
    border-color: #3b4252;
    color: #00bd7e;
  }

  .lesson-num {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.8rem;
    color: #9ca3af;
    font-weight: 500;
  }

  .lesson-title {
    font-weight: 500;
  }

  /* Journey tooltip */
  .hint-content {
    position: absolute;
    right: 2.75rem;
    bottom: calc(100% + 1.8rem);
    z-index: 4;
    width: max-content;
    max-width: 240px;
    padding-bottom: 0.9rem;
    color: #f9fafb;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.45;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(4px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0.25s ease;
  }

  .hint-content::before,
  .hint-content::after {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 1px;
    content: "";
    background: #e5e7eb;
  }

  .hint-content::before {
    width: 100%;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  .hint-content::after {
    width: 68px;
    transform: rotate(135deg) scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease 0.12s;
  }

  .journey-row:hover .hint-content,
  .journey-row:focus-visible .hint-content {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .journey-row:hover .hint-content::before,
  .journey-row:focus-visible .hint-content::before {
    transform: scaleX(1);
  }

  .journey-row:hover .hint-content::after,
  .journey-row:focus-visible .hint-content::after {
    transform: rotate(135deg) scaleX(1);
  }

  .journey-row:focus-visible {
    outline: 2px solid #00bd7e;
    outline-offset: 2px;
  }

  /* Project tooltip */
  .project-tooltip {
    position: absolute;
    right: 1rem;
    bottom: calc(100% + 4.5rem);
    z-index: 10;
    width: min(260px, calc(100vw - 2rem));
    pointer-events: auto;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.5rem);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0.25s ease;
  }

  .branch-path-svg {
    position: absolute;
    top: 100%;
    right: 0.5rem;
    width: 180px;
    height: 70px;
    overflow: visible;
  }

  .branch-line {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
    stroke: #a371f7;
    transition: stroke-dashoffset 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .branch-dot {
    fill: #a371f7;
    opacity: 0;
    transition: opacity 0.2s ease 0.35s;
  }

  .project-tooltip-cards {
    display: block;
  }

  .project-row:hover .project-tooltip,
  .project-row:focus-visible .project-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .project-row:hover .branch-line,
  .project-row:focus-visible .branch-line {
    stroke-dashoffset: 0;
  }

  .project-row:hover .branch-dot,
  .project-row:focus-visible .branch-dot {
    opacity: 1;
  }

  .project-row:focus-visible {
    outline: 2px solid #00bd7e;
    outline-offset: 2px;
  }

  /* Responsive Design */
  @media (max-width: 860px) {
    .main-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 1.5rem 1rem 4rem;
    }

    .sticky-sidebar {
      position: static;
      max-width: 320px;
      margin: 0 auto;
    }

    .metrics-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .metric-item {
      padding: 0;
    }

    .metric-item:not(:last-child) {
      border-right: none;
      border-bottom: 1px solid #1e2229;
      padding-bottom: 0.75rem;
    }

    .sliders-row {
      grid-template-columns: 1fr;
    }

    .hint-content {
      left: 1rem;
    }
  }
</style>
