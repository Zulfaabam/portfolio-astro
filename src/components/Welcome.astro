---
import ArrowUpRightSvg from "./ArrowUpRightSvg.astro";
import Nav from "./Nav.astro";
import ProfileCard from "./ProfileCard.astro";

import { supabase } from "../lib/supabase";
import { getEntry } from "astro:content";

const { data: projects, error } = await supabase
  .from("projects")
  .select(
    `*,
        project_tech_stack (
          tech_stack (
            id,
            name
          )
        )`,
  )
  .eq("is_featured", true);

const homeContent = await getEntry("home", "home");

const miniJourneys = homeContent?.data?.miniJourneys?.sort(
  (a, b) => b.id - a.id,
);

console.log("homecontent", homeContent?.data);

if (error) {
  console.error(error);
}
---

<div class="page-wrapper">
  <Nav />

  <div class="main-layout">
    <!-- Left Column / Sidebar -->
    <aside class="sidebar">
      <div class="sticky-sidebar">
        <ProfileCard />

        <!-- Action Buttons -->
        <div class="sidebar-actions">
          <a href="#read" class="btn btn-primary">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="6,4 20,12 6,20"></polygon>
            </svg>
            <span>View My Work</span>
          </a>

          <a href="#glossary" class="btn btn-secondary">
            <svg
              class="btn-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="8" y1="6" x2="21" y2="6" stroke-linecap="round"></line>
              <line x1="8" y1="12" x2="21" y2="12" stroke-linecap="round"
              ></line>
              <line x1="8" y1="18" x2="21" y2="18" stroke-linecap="round"
              ></line>
              <circle cx="4" cy="6" r="1.5" fill="currentColor"></circle>
              <circle cx="4" cy="12" r="1.5" fill="currentColor"></circle>
              <circle cx="4" cy="18" r="1.5" fill="currentColor"></circle>
            </svg>
            <span>Download Resume</span>
          </a>
        </div>
      </div>
    </aside>

    <!-- Right Column / Content -->
    <main class="content-area">
      <!-- Intro -->
      <section class="prose-section">
        <h1 class="section-heading">Hi, I'm Abam!</h1>
        <p>
          {homeContent?.data?.intro}
        </p>
      </section>

      <section class="chapters-section">
        <!-- Journey -->
        <div class="chapter-group">
          <a href="#ch-0" class="chapter-header">
            <h3>Journey</h3>
            <ArrowUpRightSvg className="header-arrow" />
          </a>

          <div class="chapter-card">
            {
              miniJourneys?.map((journey, index) => (
                <div class="lesson-row">
                  <span class="lesson-icon">
                    <ArrowUpRightSvg />
                  </span>
                  <span class="lesson-num">{index + 1}</span>
                  <span class="lesson-title">{journey.job}</span>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Chapter 1 -->
        <div class="chapter-group">
          <a href="#ch-1" class="chapter-header">
            <h3>Projects</h3>
            <ArrowUpRightSvg class="header-arrow" />
          </a>

          <div class="chapter-card">
            {
              homeContent?.data?.featuredProjects?.map((p, index) => (
                <div class="lesson-row">
                  <span class="lesson-icon">
                    <ArrowUpRightSvg />
                  </span>
                  <span class="lesson-num">{index + 1}</span>
                  <span class="lesson-title">{p.title}</span>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </main>
  </div>
</div>

<script>
  // Interactive Simulator Script
  const sliderTtft = document.getElementById(
    "sliderTtft",
  ) as HTMLInputElement | null;
  const sliderTps = document.getElementById(
    "sliderTps",
  ) as HTMLInputElement | null;
  const ttftBadge = document.getElementById("ttftBadge");
  const tpsBadge = document.getElementById("tpsBadge");
  const valTtft = document.getElementById("valTtft");
  const valTps = document.getElementById("valTps");
  const valTotal = document.getElementById("valTotal");
  const tpsSubtext = document.getElementById("tpsSubtext");
  const runBtn = document.getElementById("runBtn");
  const streamText = document.getElementById("streamText");

  const sampleWords = (
    "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor " +
    "incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam quis nostrud."
  ).split(" ");

  let isStreaming = false;
  let streamTimeout: any = null;

  function updateMetrics() {
    if (!sliderTtft || !sliderTps) return;
    const ttft = parseInt(sliderTtft.value, 10);
    const tps = parseInt(sliderTps.value, 10);
    const msPerToken = Math.round(1000 / tps);
    const tokenCount = 31;
    const totalSec = ((ttft + (tokenCount * 1000) / tps) / 1000).toFixed(1);

    if (ttftBadge) ttftBadge.textContent = `${ttft}ms`;
    if (tpsBadge) tpsBadge.textContent = `${tps}/s`;
    if (valTtft) valTtft.textContent = `${ttft}`;
    if (valTps) valTps.textContent = `${tps}`;
    if (valTotal) valTotal.textContent = `${totalSec}`;
    if (tpsSubtext) tpsSubtext.textContent = `${msPerToken}ms between tokens`;
  }

  sliderTtft?.addEventListener("input", updateMetrics);
  sliderTps?.addEventListener("input", updateMetrics);

  runBtn?.addEventListener("click", () => {
    if (!sliderTtft || !sliderTps || !streamText) return;
    if (isStreaming) {
      clearTimeout(streamTimeout);
      isStreaming = false;
    }

    const ttft = parseInt(sliderTtft.value, 10);
    const tps = parseInt(sliderTps.value, 10);
    const tokenDelay = Math.max(10, Math.round(1000 / tps));

    streamText.textContent = "Waiting for first token...";
    streamText.classList.remove("placeholder-text");
    isStreaming = true;

    streamTimeout = setTimeout(() => {
      let index = 0;
      streamText.textContent = "";

      function nextToken() {
        if (!isStreaming || !streamText) return;
        if (index < sampleWords.length) {
          streamText.textContent +=
            (index === 0 ? "" : " ") + sampleWords[index];
          index++;
          streamTimeout = setTimeout(nextToken, tokenDelay);
        } else {
          isStreaming = false;
        }
      }

      nextToken();
    }, ttft);
  });
</script>

<style>
  /* Layout & Root Variables */
  .page-wrapper {
    min-height: 100vh;
    background-color: #090a0c;
    color: #e5e7eb;
    display: flex;
    flex-direction: column;
  }

  /* Main Container Layout */
  .main-layout {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
    display: grid;
    grid-template-columns: 290px 1fr;
    gap: 4rem;
    width: 100%;
  }

  /* Sidebar */
  .sidebar {
    width: 100%;
  }

  .sticky-sidebar {
    position: sticky;
    top: 5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Sidebar Action Buttons */
  .sidebar-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.65rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }

  .btn-icon {
    width: 15px;
    height: 15px;
  }

  .btn-primary {
    background-color: #ffffff;
    color: #090a0c;
    font-weight: 600;
  }

  .btn-primary:hover {
    background-color: #e5e7eb;
  }

  .btn-secondary {
    background-color: #121418;
    color: #d1d5db;
    border-color: #20242b;
  }

  .btn-secondary:hover {
    background-color: #181b22;
    border-color: #2d323d;
    color: #ffffff;
  }

  .btn-external {
    justify-content: space-between;
  }

  .btn-content {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .external-arrow {
    width: 14px;
    height: 14px;
    color: #6b7280;
  }

  /* Content Area */
  .content-area {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* Prose Section */
  .prose-section {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .section-heading {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: #f9fafb;
    margin: 0;
  }

  .prose-section p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: #9ca3af;
  }

  .prose-section em {
    color: #d1d5db;
    font-style: italic;
  }

  /* Chapters List */
  .chapters-section {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .chapter-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .chapter-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #f9fafb;
    transition: color 0.15s ease;
  }

  .chapter-header h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .header-arrow {
    width: 14px;
    height: 14px;
    color: #6b7280;
    transition:
      transform 0.15s ease,
      color 0.15s ease;
  }

  .chapter-header:hover .header-arrow {
    color: #00bd7e;
    transform: translate(2px, -2px);
  }

  .chapter-card {
    background-color: #111317;
    border: 1px solid #1e2229;
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .lesson-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #181a20;
    color: #d1d5db;
    font-size: 0.875rem;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .lesson-row:last-child {
    border-bottom: none;
  }

  .lesson-row:hover {
    background-color: #16181f;
    color: #ffffff;
  }

  .lesson-icon {
    width: 18px;
    height: 18px;
    border: 1px solid #282d38;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6b7280;
    flex-shrink: 0;
  }

  .lesson-icon svg {
    width: 10px;
    height: 10px;
  }

  .lesson-row:hover .lesson-icon {
    border-color: #3b4252;
    color: #00bd7e;
  }

  .lesson-num {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.8rem;
    color: #9ca3af;
    font-weight: 500;
  }

  .lesson-title {
    font-weight: 500;
  }

  /* Responsive Design */
  @media (max-width: 860px) {
    .main-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 1.5rem 1rem 4rem;
    }

    .sticky-sidebar {
      position: static;
      max-width: 320px;
      margin: 0 auto;
    }

    .metrics-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .metric-item {
      padding: 0;
    }

    .metric-item:not(:last-child) {
      border-right: none;
      border-bottom: 1px solid #1e2229;
      padding-bottom: 0.75rem;
    }

    .sliders-row {
      grid-template-columns: 1fr;
    }
  }
</style>
