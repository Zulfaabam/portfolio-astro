---
import { INTRO, MINI_JOURNEYS } from "../lib/consts";
import ArrowUpRightSvg from "./ArrowUpRightSvg.astro";
import Nav from "./Nav.astro";
---

<div class="page-wrapper">
  <!-- Top Navigation -->
  <Nav />

  <!-- Main Content Layout -->
  <div class="main-layout">
    <!-- Left Column / Sidebar -->
    <aside class="sidebar">
      <div class="sticky-sidebar">
        <!-- Book / Project Card Cover -->
        <div class="book-cover">
          <div class="cover-dots"></div>
          <div class="cover-content">
            <div class="cover-header">
              <svg class="cover-icon" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="2" width="9" height="9" rx="2.5" fill="white"
                ></rect>
                <rect x="13" y="2" width="9" height="9" rx="2.5" fill="white"
                ></rect>
                <rect x="2" y="13" width="9" height="9" rx="2.5" fill="white"
                ></rect>
                <rect
                  x="13"
                  y="13"
                  width="9"
                  height="9"
                  rx="2.5"
                  fill="white"
                  opacity="0.6"></rect>
              </svg>
            </div>

            <div class="cover-titles">
              <h2 class="cover-title">Zulfa Fatah<br />Akbar Ahmad</h2>
              <p class="cover-subtitle">Software Engineer</p>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="sidebar-actions">
          <a href="#read" class="btn btn-primary">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="6,4 20,12 6,20"></polygon>
            </svg>
            <span>View My Work</span>
          </a>

          <a href="#glossary" class="btn btn-secondary">
            <svg
              class="btn-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="8" y1="6" x2="21" y2="6" stroke-linecap="round"></line>
              <line x1="8" y1="12" x2="21" y2="12" stroke-linecap="round"
              ></line>
              <line x1="8" y1="18" x2="21" y2="18" stroke-linecap="round"
              ></line>
              <circle cx="4" cy="6" r="1.5" fill="currentColor"></circle>
              <circle cx="4" cy="12" r="1.5" fill="currentColor"></circle>
              <circle cx="4" cy="18" r="1.5" fill="currentColor"></circle>
            </svg>
            <span>Download Resume</span>
          </a>

          <!-- <a href="#further-reading" class="btn btn-secondary">
            <svg
              class="btn-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
              ></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <line x1="10" y1="9" x2="8" y2="9"></line>
            </svg>
            <span>Further reading</span>
          </a>

          <a href="#source-book" class="btn btn-secondary btn-external">
            <div class="btn-content">
              <svg
                class="btn-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path
                  d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
                ></path>
              </svg>
              <span>The source book</span>
            </div>
            <svg
              class="external-arrow"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M7 17L17 7M17 7H7M17 7V17"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a> -->
        </div>
      </div>
    </aside>

    <!-- Right Column / Content -->
    <main class="content-area">
      <!-- Section 1: Intro / Story -->
      <section class="prose-section">
        <h1 class="section-heading">Hi, I'm Abam!</h1>
        <p>
          {INTRO}
        </p>
      </section>

      <!-- Section 2: Interactive Demo Section -->
      <section class="demo-section">
        <h2 class="section-subheading">Journey</h2>
        <p class="section-desc">
          This one is from chapter 1. Press run, then drag the sliders to feel
          the difference between starting fast and finishing fast.
        </p>

        <!-- Simulator Card -->
        <div class="simulator-card">
          <!-- Text Stream Box -->
          <div class="stream-display" id="streamDisplay">
            <span class="placeholder-text" id="streamText"
              >Press run to stream a response.</span
            >
          </div>

          <!-- Metrics Row -->
          <div class="metrics-grid">
            <div class="metric-item">
              <span class="metric-label">TTFT</span>
              <div class="metric-value">
                <span class="value-number" id="valTtft">400</span>
                <span class="value-unit">ms</span>
              </div>
              <span class="metric-desc"
                >Compute bound, scales with prompt length</span
              >
            </div>

            <div class="metric-item">
              <span class="metric-label">TPS</span>
              <div class="metric-value">
                <span class="value-number" id="valTps">30</span>
                <span class="value-unit">/s</span>
              </div>
              <span class="metric-desc"
                >Bandwidth bound: the same full model read every token</span
              >
            </div>

            <div class="metric-item">
              <span class="metric-label">Total</span>
              <div class="metric-value">
                <span class="value-number" id="valTotal">1.4</span>
                <span class="value-unit">s</span>
              </div>
              <span class="metric-desc">31 words end to end</span>
            </div>
          </div>

          <!-- Controls Section -->
          <div class="controls-panel">
            <div class="controls-header">
              <svg
                class="control-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="6" cy="6" r="3"></circle>
                <circle cx="6" cy="18" r="3"></circle>
                <line x1="20" y1="4" x2="8.5" y2="4" stroke-linecap="round"
                ></line>
                <line x1="20" y1="12" x2="4" y2="12" stroke-linecap="round"
                ></line>
                <line x1="20" y1="20" x2="8.5" y2="20" stroke-linecap="round"
                ></line>
              </svg>
              <span>Adjust</span>
            </div>

            <div class="sliders-row">
              <div class="slider-control">
                <div class="slider-box">
                  <span class="slider-name">Time to first token</span>
                  <div class="slider-value-badge" id="ttftBadge">400ms</div>
                </div>
                <input
                  type="range"
                  id="sliderTtft"
                  min="50"
                  max="1500"
                  step="50"
                  value="400"
                  class="range-slider"
                />
              </div>

              <div class="slider-control">
                <div class="slider-box">
                  <span class="slider-name">Tokens per second</span>
                  <div class="slider-value-badge" id="tpsBadge">30/s</div>
                </div>
                <input
                  type="range"
                  id="sliderTps"
                  min="5"
                  max="100"
                  step="5"
                  value="30"
                  class="range-slider"
                />
                <span class="slider-subtext" id="tpsSubtext"
                  >33ms between tokens</span
                >
              </div>
            </div>

            <div class="controls-action">
              <button id="runBtn" class="btn-run">
                <svg viewBox="0 0 24 24" fill="currentColor" class="run-icon">
                  <polygon points="5,3 19,12 5,21"></polygon>
                </svg>
                <span>Run</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Figure Caption -->
        <div class="figure-caption">
          <p>
            <strong
              >Figure 1.4. Time to first token versus tokens per second.</strong
            > Two numbers, two phases, two bottlenecks. A response that starts instantly
            and trickles can feel faster than one that pauses and then dumps, even
            when the second finishes first.
          </p>
          <span class="figure-subcaption">Illustrative numbers</span>
        </div>
      </section>

      <!-- Section 3: Curriculum / Chapters List -->
      <section class="chapters-section">
        <!-- Chapter 0 -->
        <div class="chapter-group">
          <a href="#ch-0" class="chapter-header">
            <h3>Journey</h3>
            <ArrowUpRightSvg className="header-arrow" />
          </a>

          <div class="chapter-card">
            {
              MINI_JOURNEYS.map((journey, index) => (
                <a href={`#journey-${index + 1}`} class="lesson-row">
                  <span class="lesson-icon">
                    <ArrowUpRightSvg />
                  </span>
                  <span class="lesson-num">{journey.id}</span>
                  <span class="lesson-title">{journey.job}</span>
                </a>
              ))
            }
          </div>
        </div>

        <!-- Chapter 1 -->
        <div class="chapter-group">
          <a href="#ch-1" class="chapter-header">
            <h3>1. Projects</h3>
            <svg
              class="header-arrow"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M7 17L17 7M17 7H7M17 7V17"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>

          <div class="chapter-card">
            <a href="#ch-1-1" class="lesson-row">
              <span class="lesson-icon">
                <ArrowUpRightSvg />
              </span>
              <span class="lesson-num">1.1</span>
              <span class="lesson-title">Scale and specialization</span>
            </a>

            <a href="#ch-1-2" class="lesson-row">
              <span class="lesson-icon">
                <ArrowUpRightSvg />
              </span>
              <span class="lesson-num">1.2</span>
              <span class="lesson-title">About your app</span>
            </a>

            <a href="#ch-1-3" class="lesson-row">
              <span class="lesson-icon">
                <ArrowUpRightSvg />
              </span>
              <span class="lesson-num">1.3</span>
              <span class="lesson-title">Model selection</span>
            </a>

            <a href="#ch-1-4" class="lesson-row">
              <span class="lesson-icon">
                <ArrowUpRightSvg />
              </span>
              <span class="lesson-num">1.4</span>
              <span class="lesson-title">Measuring latency and throughput</span>
            </a>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>

<script>
  // Interactive Simulator Script
  const sliderTtft = document.getElementById(
    "sliderTtft",
  ) as HTMLInputElement | null;
  const sliderTps = document.getElementById(
    "sliderTps",
  ) as HTMLInputElement | null;
  const ttftBadge = document.getElementById("ttftBadge");
  const tpsBadge = document.getElementById("tpsBadge");
  const valTtft = document.getElementById("valTtft");
  const valTps = document.getElementById("valTps");
  const valTotal = document.getElementById("valTotal");
  const tpsSubtext = document.getElementById("tpsSubtext");
  const runBtn = document.getElementById("runBtn");
  const streamText = document.getElementById("streamText");

  const sampleWords = (
    "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor " +
    "incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam quis nostrud."
  ).split(" ");

  let isStreaming = false;
  let streamTimeout: any = null;

  function updateMetrics() {
    if (!sliderTtft || !sliderTps) return;
    const ttft = parseInt(sliderTtft.value, 10);
    const tps = parseInt(sliderTps.value, 10);
    const msPerToken = Math.round(1000 / tps);
    const tokenCount = 31;
    const totalSec = ((ttft + (tokenCount * 1000) / tps) / 1000).toFixed(1);

    if (ttftBadge) ttftBadge.textContent = `${ttft}ms`;
    if (tpsBadge) tpsBadge.textContent = `${tps}/s`;
    if (valTtft) valTtft.textContent = `${ttft}`;
    if (valTps) valTps.textContent = `${tps}`;
    if (valTotal) valTotal.textContent = `${totalSec}`;
    if (tpsSubtext) tpsSubtext.textContent = `${msPerToken}ms between tokens`;
  }

  sliderTtft?.addEventListener("input", updateMetrics);
  sliderTps?.addEventListener("input", updateMetrics);

  runBtn?.addEventListener("click", () => {
    if (!sliderTtft || !sliderTps || !streamText) return;
    if (isStreaming) {
      clearTimeout(streamTimeout);
      isStreaming = false;
    }

    const ttft = parseInt(sliderTtft.value, 10);
    const tps = parseInt(sliderTps.value, 10);
    const tokenDelay = Math.max(10, Math.round(1000 / tps));

    streamText.textContent = "Waiting for first token...";
    streamText.classList.remove("placeholder-text");
    isStreaming = true;

    streamTimeout = setTimeout(() => {
      let index = 0;
      streamText.textContent = "";

      function nextToken() {
        if (!isStreaming || !streamText) return;
        if (index < sampleWords.length) {
          streamText.textContent +=
            (index === 0 ? "" : " ") + sampleWords[index];
          index++;
          streamTimeout = setTimeout(nextToken, tokenDelay);
        } else {
          isStreaming = false;
        }
      }

      nextToken();
    }, ttft);
  });
</script>

<style is:global>
  /* Layout & Root Variables */
  .page-wrapper {
    min-height: 100vh;
    background-color: #090a0c;
    color: #e5e7eb;
    display: flex;
    flex-direction: column;
  }

  /* Main Container Layout */
  .main-layout {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
    display: grid;
    grid-template-columns: 290px 1fr;
    gap: 4rem;
    width: 100%;
  }

  /* Sidebar */
  .sidebar {
    width: 100%;
  }

  .sticky-sidebar {
    position: sticky;
    top: 5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Book Cover Card */
  .book-cover {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.35;
    background: linear-gradient(145deg, #00bd7e 0%, #009360 50%, #007048 100%);
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 16px 36px -10px rgba(0, 189, 126, 0.25),
      0 0 0 1px rgba(255, 255, 255, 0.1) inset;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    color: #ffffff;
  }

  .cover-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      rgba(0, 48, 30, 0.35) 1.5px,
      transparent 1.5px
    );
    background-size: 10px 10px;
    pointer-events: none;
  }

  .cover-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .cover-icon {
    width: 26px;
    height: 26px;
  }

  .cover-titles {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cover-title {
    font-size: 1.75rem;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0;
    color: #ffffff;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.15);
  }

  .cover-subtitle {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    text-transform: uppercase;
  }

  /* Sidebar Action Buttons */
  .sidebar-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.65rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }

  .btn-icon {
    width: 15px;
    height: 15px;
  }

  .btn-primary {
    background-color: #ffffff;
    color: #090a0c;
    font-weight: 600;
  }

  .btn-primary:hover {
    background-color: #e5e7eb;
  }

  .btn-secondary {
    background-color: #121418;
    color: #d1d5db;
    border-color: #20242b;
  }

  .btn-secondary:hover {
    background-color: #181b22;
    border-color: #2d323d;
    color: #ffffff;
  }

  .btn-external {
    justify-content: space-between;
  }

  .btn-content {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .external-arrow {
    width: 14px;
    height: 14px;
    color: #6b7280;
  }

  /* Content Area */
  .content-area {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* Prose Section */
  .prose-section {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .section-heading {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: #f9fafb;
    margin: 0;
  }

  .prose-section p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: #9ca3af;
  }

  .prose-section em {
    color: #d1d5db;
    font-style: italic;
  }

  /* Demo Section */
  .demo-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-subheading {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #f9fafb;
    margin: 0;
  }

  .section-desc {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #9ca3af;
  }

  /* Simulator Card */
  .simulator-card {
    background-color: #111317;
    border: 1px solid #1e2229;
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .stream-display {
    min-height: 90px;
    background-color: #0b0c0f;
    border: 1px solid #1a1d24;
    border-radius: 8px;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.875rem;
    color: #e5e7eb;
    line-height: 1.5;
  }

  .placeholder-text {
    font-style: italic;
    color: #6b7280;
    font-family: inherit;
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    border-top: 1px solid #1e2229;
    border-bottom: 1px solid #1e2229;
    padding: 1rem 0;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0 1rem;
  }

  .metric-item:first-child {
    padding-left: 0;
  }

  .metric-item:not(:last-child) {
    border-right: 1px solid #1e2229;
  }

  .metric-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: #9ca3af;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .metric-value {
    display: flex;
    align-items: baseline;
    gap: 0.15rem;
  }

  .value-number {
    font-size: 1.45rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .value-unit {
    font-size: 0.85rem;
    color: #9ca3af;
    font-weight: 500;
  }

  .metric-desc {
    font-size: 0.725rem;
    line-height: 1.35;
    color: #6b7280;
  }

  /* Controls Panel */
  .controls-panel {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .controls-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #9ca3af;
  }

  .control-icon {
    width: 14px;
    height: 14px;
  }

  .sliders-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .slider-control {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .slider-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: #171a21;
    border: 1px solid #232832;
    border-radius: 6px;
    padding: 0.45rem 0.75rem;
  }

  .slider-name {
    font-size: 0.775rem;
    color: #9ca3af;
  }

  .slider-value-badge {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.775rem;
    color: #d1d5db;
    font-weight: 500;
  }

  .range-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 4px;
    background: #232832;
    border-radius: 2px;
    outline: none;
    margin: 0.25rem 0;
  }

  .range-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #00bd7e;
    cursor: pointer;
    box-shadow: 0 0 8px rgba(0, 189, 126, 0.5);
  }

  .slider-subtext {
    font-size: 0.7rem;
    color: #6b7280;
  }

  .controls-action {
    display: flex;
    justify-content: flex-start;
    margin-top: 0.25rem;
  }

  .btn-run {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: #009360;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 0.4rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .btn-run:hover {
    background-color: #00bd7e;
  }

  .run-icon {
    width: 11px;
    height: 11px;
  }

  /* Figure Caption */
  .figure-caption {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.25rem;
  }

  .figure-caption p {
    margin: 0;
    font-size: 0.825rem;
    line-height: 1.5;
    color: #9ca3af;
  }

  .figure-caption strong {
    color: #e5e7eb;
    font-weight: 600;
  }

  .figure-subcaption {
    font-size: 0.75rem;
    color: #6b7280;
  }

  /* Chapters List */
