---
import { getCollection, render } from "astro:content";
import SketchDivider from "./ui/SketchDivider.astro";
import "drawably/style.css";

const journeys = await Promise.all(
  (await getCollection("journey"))
    .sort((a, b) => b.data.start.getTime() - a.data.start.getTime())
    .map(async (entry) => ({ ...entry, ...(await render(entry)) })),
);
---

<ul class="journey-accordion">
  {
    journeys.map(({ data, Content }) => (
      <li class="journey-row">
        <details class="journey-item" name="home-journey">
          <summary>
            <span class="journey-year">
              <time datetime={data.start.toISOString()}>
                {data.start.getUTCFullYear()}
              </time>
              {data.end &&
              data.end.getUTCFullYear() !== data.start.getUTCFullYear() ? (
                <>
                  {" – "}
                  <time datetime={data.end.toISOString()}>
                    {data.end.getUTCFullYear()}
                  </time>
                </>
              ) : !data.end ? (
                " – Now"
              ) : null}
            </span>
            <span class="journey-job">
              {data.role} @ {data.company}
            </span>
            <small class="journey-location">{data.location}</small>
            <svg
              class="journey-chevron"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <div class="journey-content">
            <p class="journey-summary">{data.summary}</p>
            <div class="journey-highlights">
              <Content />
            </div>
            <ul
              class="journey-stack"
              aria-label={`${data.role} at ${data.company} technology stack`}
            >
              {data.technologies.map((technology) => (
                <li>
                  <span class="journey-badge" data-journey-badge>
                    {technology}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </details>
        <SketchDivider class="journey-divider" />
      </li>
    ))
  }
</ul>

<script>
  import { drawablyBadge } from "drawably";
  import { initializeSketches } from "./ui/initializeSketches";

  initializeSketches("[data-journey-badge]", (element) =>
    drawablyBadge(element, { variant: "outline", roughness: 0.8, boil: 0.2 }),
  );

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const summary = event.target.closest(".journey-item > summary");
    const accordion = summary?.closest(".journey-accordion");
    if (!accordion) return;

    // Include the previously open item: native exclusive details closes it too.
    // Keyboard activation removes transitions from the whole group immediately.
    accordion.querySelectorAll(".journey-item").forEach((item) => {
      item.toggleAttribute("data-pointer-toggle", event.detail > 0);
    });
  });
</script>

<style>
  .journey-accordion {
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journey-row {
    position: relative;
  }

  .journey-divider {
    position: absolute;
    bottom: -5px;
    left: 0;
    right: 0;
  }

  summary {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) auto 0.75rem;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 0 0.75rem;
    color: var(--color-black);
    font-size: 0.875rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 4px;
  }

  summary:hover .journey-job {
    color: var(--color-blue);
  }

  .journey-job {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .journey-item[open] .journey-job {
    font-weight: 600;
  }

  .journey-year {
    color: var(--color-dark-gray);
    font-size: 0.75rem;
    line-height: 1.5;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .journey-location {
    color: var(--color-dark-gray);
    font-size: 0.7rem;
  }

  .journey-chevron {
    width: 0.75rem;
    height: 0.75rem;
    color: var(--color-dark-gray);
    transform: rotate(0deg);
  }

  .journey-item[data-pointer-toggle] .journey-chevron {
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .journey-item[open] .journey-chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-chevron,
    .journey-item[data-pointer-toggle] .journey-chevron {
      transition: opacity 100ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    summary:active:not(:focus-visible) .journey-chevron {
      opacity: 0.7;
    }
  }

  .journey-content {
    padding: 0.5rem 0 1rem 5.8rem;
    color: var(--color-dark-gray);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .journey-summary {
    margin: 0 0 1rem;
  }

  .journey-highlights :global(h2) {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .journey-highlights :global(ul) {
    margin: 0 0 1rem;
    padding-left: 1rem;
  }

  .journey-highlights :global(li + li) {
    margin-top: 0.3rem;
  }

  .journey-highlights :global(li::marker) {
    color: var(--color-blue);
  }

  .journey-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journey-badge {
    display: inline-block;
    padding: 0.25rem 0.55rem;
    font-size: 0.7rem;
    line-height: 1.4;
    --drawably-stroke: var(--color-blue);
  }

  @media (max-width: 860px) {
    summary {
      grid-template-columns: 5rem minmax(0, 1fr) 0.75rem;
    }

    .journey-location {
      grid-column: 2;
      grid-row: 2;
    }

    .journey-chevron {
      grid-column: 3;
      grid-row: 1 / 3;
    }
  }

  @media (max-width: 560px) {
    .journey-content {
      padding-left: 0;
    }
  }
</style>
