---
import "drawably/style.css";
import "drawably/font.css";
import { getEntry, getCollection } from "astro:content";
import ProfileCard from "./ProfileCard.astro";
import PaperNoteCustomDialog from "./PaperNoteCustomDialog.astro";
import SketchButton from "./ui/SketchButton.astro";
import FeaturedProjects from "./FeaturedProjects.astro";
import SketchDivider from "./ui/SketchDivider.astro";

const homeContent = await getEntry("home", "home");
const miniJourneys =
  homeContent?.data?.miniJourneys?.sort((a, b) => b.id - a.id) ?? [];
const projects = (await getCollection("projects"))
  .sort((a, b) => b.data.created_at.getTime() - a.data.created_at.getTime())
  .slice(0, 10)
  // Keep featured entries first while preserving newest-first order in each group.
  .sort((a, b) => Number(b.data.is_featured) - Number(a.data.is_featured))
  .map(({ id, data }) => ({
    id,
    title: data.title,
    description: data.description,
    repository: data.github_url,
    demo: data.live_url,
    featured: data.is_featured,
    image: data.image,
    status: data.is_featured
      ? "Featured"
      : String(data.created_at.getUTCFullYear()),
  }));
const featuredProjects = projects
  .filter((project) => project.featured)
  .slice(0, 3);
---

<div class="sketch-page">
  <div class="sketch-layout">
    <aside class="sketch-sidebar">
      <div class="sidebar-stack">
        <ProfileCard />
        <div class="actions">
          <SketchButton
            fullWidth
            data-dialog-trigger="project-notes"
            data-dialog-page="0"
            aria-haspopup="dialog"
            aria-controls="project-notes"
            disabled={projects.length === 0}>View My Projects</SketchButton
          >
          <SketchButton variant="outline" fullWidth
            >Download Resume</SketchButton
          >
        </div>
      </div>
    </aside>

    <main class="content">
      <section class="intro">
        <span class="drawably-badge" data-drawably-badge>HELLO</span>
        <h1>I'm Abam!</h1>
        <p>{homeContent?.data?.intro}</p>
      </section>

      <section class="chapters">
        <div class="chapter">
          <h3><span>Journey</span></h3>
          <ul class="drawably-list" data-drawably-list>
            {
              miniJourneys.map((journey, index) => (
                <li>
                  <span class="number job-year">{journey.year}</span>
                  <span>{journey.job}</span>
                  <small>{journey.place}</small>
                  <SketchDivider class="row-divider" />
                </li>
              ))
            }
          </ul>
        </div>

        <div class="chapter">
          <h3><span>Projects</span></h3>
          <FeaturedProjects projects={featuredProjects} />
          <div class="load-more-btn">
            <SketchButton
              variant="outline"
              data-dialog-trigger="project-notes"
              data-dialog-page="0"
              aria-haspopup="dialog"
              aria-controls="project-notes"
              disabled={projects.length === 0}
              size="small"
            >
              Load more
            </SketchButton>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>
{
  projects.length > 0 && (
    <PaperNoteCustomDialog
      id="project-notes"
      itemLabel="Project"
      pages={projects.map((project) => ({
        kicker: project.title,
        title: project.title,
        body: project.description ?? "",
        images: [
          {
            src: project.image,
            alt: `${project.title} overview screenshot`,
            caption: "01 / The overview",
          },
        ],
        links: [
          {
            href: project.repository,
            label: project.repository
              ? "View repository"
              : "Private repository",
          },
          {
            href: project.demo,
            label: project.demo ? "Visit live demo" : "Demo coming soon",
          },
        ],
      }))}
    />
  )
}

<script>
  import { drawablyBadge, drawablyCard } from "drawably";
  import { initializeSketches } from "./ui/initializeSketches";

  initializeSketches("[data-drawably-card]", (el) =>
    drawablyCard(el, {
      roughness: 0.8,
      boil: 0.2,
      fill: "#2724d1",
    })
  );
  initializeSketches("[data-drawably-badge]", (el) =>
    drawablyBadge(el, { roughness: 0.8, boil: 0.2, variant: "outline" })
  );
</script>

<style>
  .sketch-page {
    min-height: calc(100svh - var(--nav-height));
    background: var(--color-white);
    color: var(--color-black);
  }
  .sketch-layout {
    max-width: var(--site-width);
    margin: auto;
    padding: 3rem var(--site-gutter) 6rem;
    display: grid;
    grid-template-columns: 290px 1fr;
    gap: 4rem;
  }
  .sidebar-stack {
    position: sticky;
    top: calc(var(--nav-height) + 1rem);
    display: grid;
    gap: 1rem;
  }

  .actions {
    display: grid;
    gap: 0.65rem;
  }
  .content {
    display: grid;
    gap: 3.5rem;
  }

  /* INTRO */
  .intro {
    display: grid;
    gap: 1rem;
  }
  .drawably-badge {
    width: max-content;
    padding: 0.2rem 0.55rem;
    color: var(--color-black);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }
  .intro h1 {
    margin: 0;
    color: var(--color-black);
    font-size: 1.75rem;
  }
  .intro p {
    margin: 0;
    color: var(--color-dark-gray);
    font-size: 0.95rem;
    line-height: 1.65;
    white-space: pre-line;
  }

  /* CHAPTERS */
  .chapters {
    display: grid;
    gap: 2.25rem;
  }
  .chapter {
    display: grid;
    gap: 0.8rem;
  }
  .chapter h3 {
    margin: 0;
    display: flex;
    gap: 0.4rem;
    align-items: center;
    color: var(--color-black);
    font-size: 1.1rem;
  }
  .arrow,
  .project-arrow {
    color: var(--color-green);
  }
  .drawably-list {
    margin: 0;
    padding: 0;
    background: var(--color-white);
  }
  .drawably-list li {
    position: relative;
    display: grid;
    grid-template-columns: 5rem 1fr auto;
    gap: 0.8rem;
    align-items: center;
    padding: 1rem 0 0.75rem 0;
    /* border-bottom: 1px solid var(--color-gray); */
    color: var(--color-black);
    font-size: 0.875rem;
    list-style: none;
  }
  .drawably-list li:last-child {
    border-bottom: 0;
  }
  .row-divider {
    position: absolute;
    bottom: -5px;
    left: 0;
    right: 0;
  }

  /* .drawably-list li:last-child .drawably-divider {
    display: none;
  } */

  .number,
  .job-year {
    color: var(--color-dark-gray);
    font-size: 0.75rem;
  }

  .drawably-list small {
    color: var(--color-dark-gray);
    font-size: 0.7rem;
  }

  .load-more-btn {
    margin-left: auto;
  }

  @media (max-width: 860px) {
    .sketch-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 1.5rem 1rem 4rem;
    }
    .sidebar-stack {
      position: static;
      max-width: 320px;
      margin: auto;
    }
    .drawably-list li {
      grid-template-columns: 5rem 1fr;
    }
    .drawably-list small {
      grid-column: 2;
    }
  }
</style>
