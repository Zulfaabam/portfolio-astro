---
import "drawably/style.css";
import "drawably/font.css";
import { getEntry, getCollection } from "astro:content";
import ProfileCard from "./ProfileCard.astro";
import PaperNoteCustomDialog from "./PaperNoteCustomDialog.astro";
import SketchButton from "./ui/SketchButton.astro";
import ExternalLink from "./ui/ExternalLink.astro";
import SketchDivider from "./ui/SketchDivider.astro";

const homeContent = await getEntry("home", "home");
const miniJourneys =
  homeContent?.data?.miniJourneys?.sort((a, b) => b.id - a.id) ?? [];
const projects = (await getCollection("projects"))
  .sort((a, b) => b.data.created_at.getTime() - a.data.created_at.getTime())
  .slice(0, 10)
  // Keep featured entries first while preserving newest-first order in each group.
  .sort((a, b) => Number(b.data.is_featured) - Number(a.data.is_featured))
  .map(({ id, data }) => ({
    id,
    title: data.title,
    description: data.description,
    repository: data.github_url,
    demo: data.live_url,
    featured: data.is_featured,
    status: data.is_featured
      ? "Featured"
      : String(data.created_at.getUTCFullYear()),
  }));
const initialIds = new Set(
  projects
    .filter((project) => project.featured)
    .slice(0, 3)
    .map((project) => project.id),
);
// Keep the preview useful if fewer than three projects are marked featured.
for (const project of projects) {
  if (initialIds.size >= 3) break;
  initialIds.add(project.id);
}
const hasMoreProjects = projects.length > initialIds.size;
---

<div class="sketch-page">
  <div class="sketch-layout">
    <aside class="sketch-sidebar">
      <div class="sidebar-stack">
        <ProfileCard />
        <div class="actions">
          <SketchButton
            fullWidth
            data-show-projects
            aria-controls="project-list">View My Projects</SketchButton
          >
          <SketchButton variant="outline" fullWidth
            >Download Resume</SketchButton
          >
        </div>
      </div>
    </aside>

    <main class="content">
      <section class="intro">
        <span class="drawably-badge" data-drawably-badge>HELLO</span>
        <h1>I'm Abam!</h1>
        <p>{homeContent?.data?.intro}</p>
      </section>

      <section class="chapters">
        <div class="chapter">
          <h3><span>Journey</span></h3>
          <ul class="drawably-list" data-drawably-list>
            {
              miniJourneys.map((journey, index) => (
                <li>
                  <span class="number job-year">{journey.year}</span>
                  <span>{journey.job}</span>
                  <small>{journey.place}</small>
                  <SketchDivider class="row-divider" />
                </li>
              ))
            }
          </ul>
        </div>

        <div class="chapter">
          <h3><span>Projects</span></h3>
          <ul id="project-list" class="drawably-list project-list">
            {
              projects.map((project) => (
                <li
                  hidden={!initialIds.has(project.id)}
                  data-project-row
                  data-project-preview={
                    initialIds.has(project.id) ? "true" : "false"
                  }
                >
                  <span class="project-status">{project.status}</span>
                  <button
                    type="button"
                    class="project-title"
                    data-dialog-trigger={`project-note-${project.id}`}
                    aria-haspopup="dialog"
                    aria-controls={`project-note-${project.id}`}
                  >
                    {project.title}
                  </button>
                  <span class="project-links">
                    {project.repository && (
                      <ExternalLink
                        href={project.repository}
                        aria-label={`${project.title} repository`}
                      >
                        Code
                      </ExternalLink>
                    )}
                    {project.demo && (
                      <ExternalLink
                        href={project.demo}
                        aria-label={`${project.title} live demo`}
                      >
                        Demo
                      </ExternalLink>
                    )}
                    {!project.repository && !project.demo && (
                      <small>Private</small>
                    )}
                  </span>
                  <SketchDivider class="row-divider" />
                </li>
              ))
            }
          </ul>
          {
            hasMoreProjects && (
              <div data-load-more-wrapper>
                <SketchButton
                  variant="outline"
                  data-load-more-projects
                  aria-controls="project-list"
                  aria-expanded="false"
                >
                  <span data-project-toggle-label>Load more</span>
                </SketchButton>
              </div>
            )
          }
          <p class="project-count" data-project-count role="status">
            Showing {initialIds.size} of {projects.length} projects
          </p>
        </div>
      </section>
    </main>
  </div>
</div>
{
  projects.map((project) => (
    <PaperNoteCustomDialog
      id={`project-note-${project.id}`}
      title={project.title}
      pages={[{ kicker: "Project details", title: project.title, body: "" }]}
    >
      <div class="project-details">
        {project.description && <p>{project.description}</p>}
        {project.repository ? (
          <ExternalLink href={project.repository} underline>
            View repository
          </ExternalLink>
        ) : (
          <p>Private repository</p>
        )}
        {project.demo ? (
          <ExternalLink href={project.demo} underline>
            Visit live demo
          </ExternalLink>
        ) : (
          <p>Demo coming soon</p>
        )}
      </div>
    </PaperNoteCustomDialog>
  ))
}

<script>
  import { drawablyBadge, drawablyCard } from "drawably";
  import { initializeSketches } from "./ui/initializeSketches";

  // Delegation keeps the controls working after Astro client-side navigation.
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const trigger = event.target.closest(
      "[data-load-more-projects], [data-show-projects]",
    );
    if (!trigger) return;
    const list = document.querySelector<HTMLElement>("#project-list");
    if (!list) return;
    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-load-more-projects]",
    );
    const expanded =
      trigger.hasAttribute("data-show-projects") ||
      toggle?.getAttribute("aria-expanded") !== "true";
    const firstHidden = list.querySelector<HTMLElement>(
      "[data-project-row][hidden] .project-title",
    );
    list.querySelectorAll<HTMLElement>("[data-project-row]").forEach((row) => {
      row.hidden = !expanded && row.dataset.projectPreview !== "true";
    });
    toggle?.setAttribute("aria-expanded", String(expanded));
    const label = toggle?.querySelector<HTMLElement>(
      "[data-project-toggle-label]",
    );
    if (label) label.textContent = expanded ? "Show less" : "Load more";
    const count = document.querySelector<HTMLElement>("[data-project-count]");
    if (count)
      count.textContent = expanded
        ? `Showing all ${list.children.length} projects`
        : `Showing ${list.querySelectorAll("[data-project-row]:not([hidden])").length} of ${list.children.length} projects`;
    if (trigger.hasAttribute("data-show-projects")) {
      list
        .querySelector<HTMLElement>(".project-title")
        ?.focus({ preventScroll: true });
      list.scrollIntoView({ block: "start" });
    } else if (expanded) {
      firstHidden?.focus();
    } else {
      toggle?.focus();
    }
  });

  initializeSketches("[data-drawably-card]", (el) =>
    drawablyCard(el, {
      roughness: 0.8,
      boil: 0.2,
      fill: "#2724d1",
    }),
  );
  initializeSketches("[data-drawably-badge]", (el) =>
    drawablyBadge(el, { roughness: 0.8, boil: 0.2, variant: "outline" }),
  );
</script>

<style>
  .sketch-page {
    min-height: calc(100svh - var(--nav-height));
    background: var(--color-white);
    color: var(--color-black);
  }
  .sketch-layout {
    max-width: var(--site-width);
    margin: auto;
    padding: 3rem var(--site-gutter) 6rem;
    display: grid;
    grid-template-columns: 290px 1fr;
    gap: 4rem;
  }
  .sidebar-stack {
    position: sticky;
    top: calc(var(--nav-height) + 1rem);
    display: grid;
    gap: 1rem;
  }

  .actions {
    display: grid;
    gap: 0.65rem;
  }
  .content {
    display: grid;
    gap: 3.5rem;
  }

  /* INTRO */
  .intro {
    display: grid;
    gap: 1rem;
  }
  .drawably-badge {
    width: max-content;
    padding: 0.2rem 0.55rem;
    color: var(--color-black);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }
  .intro h1 {
    margin: 0;
    color: var(--color-black);
    font-size: 1.75rem;
  }
  .intro p {
    margin: 0;
    color: var(--color-dark-gray);
    font-size: 0.95rem;
    line-height: 1.65;
    white-space: pre-line;
  }

  /* CHAPTERS */
  .chapters {
    display: grid;
    gap: 2.25rem;
  }
  .chapter {
    display: grid;
    gap: 0.8rem;
  }
  .chapter h3 {
    margin: 0;
    display: flex;
    gap: 0.4rem;
    align-items: center;
    color: var(--color-black);
    font-size: 1.1rem;
  }
  .arrow,
  .project-arrow {
    color: var(--color-green);
  }
  .drawably-list {
    margin: 0;
    padding: 0;
    background: var(--color-white);
  }
  .drawably-list li {
    position: relative;
    display: grid;
    grid-template-columns: 5rem 1fr auto;
    gap: 0.8rem;
    align-items: center;
    padding: 1rem 0 0.75rem 0;
    /* border-bottom: 1px solid var(--color-gray); */
    color: var(--color-black);
    font-size: 0.875rem;
    list-style: none;
  }
  .drawably-list li:last-child {
    border-bottom: 0;
  }
  .project-list li[hidden],
  [data-load-more-wrapper][hidden] {
    display: none;
  }
  .project-list {
    scroll-margin-top: calc(var(--nav-height) + 1rem);
  }
  .project-count {
    margin: 0;
    color: var(--color-dark-gray);
    font-size: 0.75rem;
  }
  .row-divider {
    position: absolute;
    bottom: -5px;
    left: 0;
    right: 0;
  }

  /* .drawably-list li:last-child .drawably-divider {
    display: none;
  } */

  .number,
  .job-year {
    color: var(--color-blue);
    font-size: 0.75rem;
  }

  .drawably-list small {
    color: var(--color-dark-gray);
    font-size: 0.7rem;
  }
  .project-title {
    min-width: 0;
    padding: 0;
    border: 0;
    color: var(--color-black);
    font: inherit;
    text-align: left;
    cursor: pointer;
    background: transparent;
  }
  .project-status {
    color: var(--color-blue);
    font-size: 0.75rem;
  }
  .project-links {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--color-blue);
  }
  .project-links a {
    white-space: nowrap;
  }
  .project-title:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .project-title:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 4px;
  }
  .project-details {
    display: grid;
    gap: 1rem;
  }
  .project-details p {
    margin: 0;
  }
  @media (max-width: 860px) {
    .sketch-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 1.5rem 1rem 4rem;
    }
    .sidebar-stack {
      position: static;
      max-width: 320px;
      margin: auto;
    }
    .drawably-list li {
      grid-template-columns: 2rem 1fr;
    }
    .drawably-list small {
      grid-column: 2;
    }
    .project-list li {
      grid-template-columns: 5rem minmax(0, 1fr) auto;
    }
  }
</style>
