---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import WritingLayout from "../../layouts/WritingLayout.astro";
import SketchArrow from "../../components/ui/SketchArrow";
import { getPublishedPosts, formatPostDate, readingTime } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<WritingLayout
  title={post.data.title}
  description={post.data.description}
  class="writing-shell-detail"
>
  <a class="writing-back" href="/blog">
    <SketchArrow direction="left" /> All notes & stories
  </a>
  <div class="writing-detail">
    <article class="writing-paper">
      <header class="writing-article-header">
        <div class="writing-meta">
          <span class="writing-category">{post.data.category}</span>
          <time datetime={post.data.published.toISOString()}>
            {formatPostDate(post.data.published)}
          </time>
          <span>{readingTime(post.body)} min read</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="writing-deck">{post.data.description}</p>
      </header>
      <div class="writing-prose"><Content /></div>
      <footer class="writing-article-footer">
        <span>Thanks for reading.</span><a href="/blog">
          More notes & stories <SketchArrow />
        </a>
      </footer>
    </article>
  </div>
</WritingLayout>
